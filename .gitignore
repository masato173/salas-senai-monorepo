node_modules/
dist/
*.bak
backup-*/

# Exports/logs de sessao do Claude Code
*local-command-caveat*
*-the-messages-below.txt

# E2E - artefatos de execucao (nao versionar)
tools/e2e/temp-skills/
tools/e2e/*.png
recon_*.png
e2e_*.png

# Turbo cache
.turbo/

# Coverage reports
apps/reservations/coverage/

# Backups locais
*.bak-*

# Variáveis de ambiente de teste (credenciais E2E)
.env.test

# Servidor local Docker (infra/docker) — arquivo real com secrets; o
# template infra/docker/.env.local.example É commitado normalmente
infra/docker/.env.local

# Claude Code hooks — logs locais, não versionar
.claude/hooks/*-log.txt

# Variáveis de ambiente — qualquer .env em qualquer pasta; só templates entram.
# `.env.*` também casa `.env.local.example`, por isso a negação `.env.*.example`.
.env
.env.*
!.env.example
!.env.*.example
!*.env.example


# saidas de ferramentas locais
.vercel/
test-results/
playwright-report/
graphify-out/