{
  "name": "@salas-senai/reservations",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev":       "vite",
    "build":     "tsc --noEmit && vite build",
    "preview":   "vite preview",
    "test":      "vitest run --coverage",
    "test:watch":"vitest",
    "typecheck": "tsc --noEmit",
    "lint":      "eslint src --ext .ts,.tsx --max-warnings 0",
    "clean":     "rm -rf dist coverage"
  },
  "dependencies": {
    "lucide-react":        "^0.383.0",
    "react":               "^18.3.1",
    "react-dom":           "^18.3.1",
    "react-router-dom":    "^6.23.1",
    "zustand":             "^4.5.2",
    "zod":                 "^3.23.4"
  },
  "devDependencies": {
    "@salas-senai/eslint-config": "workspace:*",
    "@salas-senai/tsconfig":      "workspace:*",
    "@types/react":               "^18.3.1",
    "@types/react-dom":           "^18.3.0",
    "@vitejs/plugin-react":       "^4.3.0",
    "@vitest/coverage-v8":        "^1.6.0",
    "jsdom":                      "^24.0.0",
    "typescript":                 "^5.4.5",
    "vite":                       "^5.2.11",
    "vitest":                     "^1.6.0"
  }
}
