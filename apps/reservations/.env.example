# Variáveis de ambiente do frontend React (apps/reservations).
# Copiar para .env.local e preencher conforme o ambiente.
# NÃO commitar .env.local — está no .gitignore.
#
# URL base do backend NestJS.
# Padrão de desenvolvimento: http://localhost:3000
VITE_API_URL=http://localhost:3000

# Feature flag: ativar backend NestJS como driver principal.
# 'true'  → usa NestJS para listReservations, createReservation,
#            cancelReservation, fetchSchedule e availability (padrão F5.8+)
# 'false' → fallback para Apps Script (legado — apenas para rollback)
# Apps Script permanece apenas como fonte de sync de aulas (POST /sync/schedules).
VITE_BACKEND_DRIVER=true
