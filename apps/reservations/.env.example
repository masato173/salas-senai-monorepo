# Variáveis de ambiente do frontend React (apps/reservations).
# Copiar para .env.local e preencher conforme o ambiente.
# NÃO commitar .env.local — está no .gitignore.
#
# URL base do backend NestJS.
# Padrão de desenvolvimento: http://localhost:3000
VITE_API_URL=http://localhost:3000

# Feature flag: ativar driver de disponibilidade via backend NestJS.
# 'true'  → usa GET /availability (backend NestJS F4.6)
# 'false' → usa buildRoomAvailability local + Apps Script (legado)
# Padrão: desligado (string vazia ou ausente = false)
VITE_BACKEND_DRIVER=false
