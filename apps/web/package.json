{
  "name": "@salas-senai/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev":        "vite",
    "build":      "tsc --noEmit && vite build",
    "preview":    "vite preview",
    "test":       "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck":  "tsc --noEmit",
    "lint":       "eslint src --ext .ts,.tsx",
    "lint:fix":   "eslint src --ext .ts,.tsx --fix",
    "clean":      "rm -rf dist coverage"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@salas-senai/eslint-config": "workspace:*",
    "@salas-senai/tsconfig":      "workspace:*",
    "@types/node":                "^20.12.0",
    "@vitejs/plugin-legacy":      "^5.3.2",
    "@vitest/coverage-v8":        "^1.4.0",
    "jsdom":                      "^24.0.0",
    "typescript":                 "^5.4.3",
    "vite":                       "^5.2.6",
    "vitest":                     "^1.4.0"
  }
}
