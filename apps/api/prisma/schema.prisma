generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  PROFESSOR
  COORDENADOR
  ADMIN
}

enum RoomType {
  SALA_COMUM
  LAB_GERAL
  LAB_INFORMATICA
  LAB_CLP
  LAB_ELETRICA
  LAB_SMT
  LAB_ELETRONICA
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Fase C1 — enum criado agora (mesma migration de createdByUserId) pra
// evitar uma segunda migration em produção logo depois. NENHUMA lógica de
// notificação é implementada nesta fase — isso é Fase C2 (missão futura).
enum NotificationType {
  RESERVATION_PENDING
  RESERVATION_CONFIRMED
  RESERVATION_REJECTED
  RESERVATION_CANCELLED
  RESERVATION_RESCHEDULED
  RESERVATION_REMINDER
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(PROFESSOR)
  active       Boolean       @default(true)
  reservations Reservation[]
  // Reservas criadas por este usuário em nome de outro (proxy) — dono
  // real fica em Reservation.userId; aqui é sempre quem clicou em criar.
  createdReservations Reservation[]  @relation("ReservationCreatedBy")
  notifications       Notification[]
  auditLogs    AuditLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
}

model Room {
  id           String        @id @default(cuid())
  name         String        @unique
  type         RoomType
  capacity     Int?
  floor        Int?
  available    Boolean       @default(true)
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Sem campo `turno` — reservas têm inicio/fim livres (06:00-23:00).
// Turno M/V/N pertence apenas a Schedule (aulas do legado). Decisão F4.0 Opção A.
model Reservation {
  id              String            @id @default(cuid())
  userId          String
  roomId          String
  groupId         String?
  date            String            // YYYY-MM-DD — string pra paridade com legado
  inicio          String            // HH:MM
  fim             String            // HH:MM
  status          ReservationStatus @default(PENDING)
  turma           String?
  notes           String?
  clientRequestId String?           @unique
  // Quem de fato criou a reserva — só difere de userId em reserva por
  // proxy (COORDENADOR/ADMIN criando em nome de um professor). Opcional
  // pra não quebrar reservas já existentes antes desta migration.
  createdByUserId String?
  createdBy       User?             @relation("ReservationCreatedBy", fields: [createdByUserId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
  room            Room              @relation(fields: [roomId], references: [id])
  notifications   Notification[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  @@index([roomId, date])
  @@index([userId])
  @@index([status])
  @@index([groupId])
  // F9.6 — availability/dashboard filtram por (date, status) sem roomId
  @@index([date, status])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  reservationId String?
  type          NotificationType
  title         String
  body          String
  read          Boolean          @default(false)
  createdAt     DateTime         @default(now())

  user        User         @relation(fields: [userId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  userId     String
  before     Json?
  after      Json?
  ip         String?
  user       User     @relation(fields: [userId], references: [id])
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Aulas importadas do Apps Script via POST /sync/schedules.
// Sem FK para Room: sala é string-name do legado (pode ter variações).
// Sincronização: full-replace (DELETE + INSERT) a cada sync manual.
model Schedule {
  id    String  @id @default(cuid())
  date  String  // YYYY-MM-DD
  sala  String  // nome da sala (paridade com Apps Script)
  turma String
  mes   String
  turno String? // 'M' | 'V' | 'N' ou null
  inicio String? // HH:MM — inferido do turno no sync
  fim    String? // HH:MM — inferido do turno no sync

  @@index([date])
  @@index([sala, date])
}
