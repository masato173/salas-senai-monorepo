# ─────────────────────────────────────────────
# @salas-senai/api — variáveis de ambiente
# Copie para .env e preencha os valores reais
# NUNCA commite o .env com valores reais
# ─────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# Preparação F4.1+ (Prisma) — opcional em F4.0
# Supabase: pooled (porta 6543) — runtime
DATABASE_URL=postgresql://postgres.[ref]:[senha]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase: direct (porta 5432) — prisma migrate + seed
DIRECT_URL=postgresql://postgres.[ref]:[senha]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Preparação F4.5+ (Redis) — opcional em F4.0
REDIS_URL=redis://localhost:6379

# Preparação F4.2+ (Auth) — opcional em F4.0
# Gerar com: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# F9.1 — CORS: origens permitidas, separadas por vírgula
# Produção (GitHub Pages): https://masato173.github.io
CORS_ORIGIN=

# Apps Script (SyncModule — POST /sync/schedules)
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# F9.2 — rate limiting: 'true' desliga o throttling (usado apenas no CI E2E,
# cujo helper faz polling em POST /auth/login). NUNCA usar em produção.
# O boot REJEITA THROTTLE_SKIP=true com NODE_ENV=production.
# THROTTLE_SKIP=true

# #21 — proxies confiáveis à frente da api (X-Forwarded-For → req.ip → rate
# limiting). Inteiro >= 0 (quantos proxies) ou 'false' (nenhum); 'true' é
# recusado. OBRIGATÓRIO com NODE_ENV=production (o boot falha sem ela):
# Railway = 1 (borda do Railway); infra/docker = 1, já fixado no compose (nginx).
# Em dev, ausente = false (o browser fala direto com a api). Ver ADR-009.
# TRUST_PROXY=1

# Seed (prisma db seed) — senhas das contas admin/coordenador/professor.
# Obrigatórias para rodar o seed, sem default; mínimo 12 caracteres cada.
# Use senhas únicas e não reaproveite em produção. Ver ADR-005.
SEED_ADMIN_PASSWORD=
SEED_COORDENADOR_PASSWORD=
SEED_PROFESSOR_PASSWORD=

# E2E local (Playwright) — mesmos valores das SEED_*_PASSWORD acima.
# No CI elas são geradas por execução; aqui são obrigatórias (sem fallback).
E2E_ADMIN_PASSWORD=
E2E_COORDENADOR_PASSWORD=
E2E_PROFESSOR_PASSWORD=
