{
  "name": "@salas-senai/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS backend — SENAI Salas (F4.0 scaffolding)",
  "main": "dist/main.js",
  "prisma": {
    "seed": "node_modules/.bin/ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "scripts": {
    "prebuild": "rimraf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "concurrently -k -n tsc,node -c blue,green \"tsc -p tsconfig.build.json --watch\" \"nodemon --watch dist --delay 500ms dist/main.js\"",
    "start:debug": "node --inspect dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "vitest run --config test/vitest.config.ts",
    "test:watch": "vitest --config test/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.10",
    "@prisma/client": "^5.22.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/platform-express": "^10.3.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "prisma": "^5.22.0",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.3.10",
    "@salas-senai/eslint-config": "workspace:*",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/supertest": "^6.0.2",
    "rimraf": "^5.0.10",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3",
    "vitest": "^1.6.1"
  }
}
