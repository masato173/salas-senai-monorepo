{
  "name": "@salas-senai/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS backend — SENAI Salas (F4.0 scaffolding)",
  "main": "dist/main.js",
  "prisma": {
    "seed": "node_modules/.bin/ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "prebuild": "rimraf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "concurrently -k -n tsc,node -c blue,green \"tsc -p tsconfig.build.json --watch\" \"nodemon --watch dist --delay 500ms dist/main.js\"",
    "start:debug": "node --inspect dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "vitest run --config test/vitest.config.ts",
    "test:unit": "vitest run --config test/vitest.unit.config.ts",
    "test:watch": "vitest --config test/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/platform-socket.io": "10.4.22",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "10.4.22",
    "@prisma/client": "^5.22.0",
    "@salas-senai/shared": "workspace:*",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.3.10",
    "@salas-senai/eslint-config": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "rimraf": "^5.0.10",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3",
    "vitest": "^4.1.11"
  }
}
