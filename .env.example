# ─────────────────────────────────────────────
# SENAI Salas — variáveis de ambiente
# Copie para .env e preencha os valores reais
# NUNCA commite o .env com valores reais
# ─────────────────────────────────────────────

# Apps Script (legado — Fase 0)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/SEU_DEPLOY_ID/exec
# Nota: em produção, o token deve ficar no backend (Fase 2)
# Nesta fase o frontend ainda o usa diretamente
VITE_APPS_SCRIPT_TOKEN=

# Backend proxy (Fase 2+)
BACKEND_URL=http://localhost:3001
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Banco de dados (Fase 4+)
DATABASE_URL=postgresql://user:password@localhost:5432/salas_senai
REDIS_URL=redis://localhost:6379

# Node
NODE_ENV=development
