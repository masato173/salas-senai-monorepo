# infra/docker/Dockerfile.api
#
# Build do backend NestJS (@salas-senai/api) para o servidor local do SENAI.
# Multi-stage: builder compila com o monorepo pnpm inteiro (pacotes internos
# @salas-senai/* — só @salas-senai/shared, via `import type`, elidido do JS
# final — precisam do workspace completo pra resolver em build-time); runner
# só copia o necessário pra rodar via entrypoint.sh (migrate deploy + seed
# condicional + `exec node apps/api/dist/main.js` — mesmo comando que já
# roda em produção hoje via railway.json, deploy.startCommand).
#
# Contexto de build esperado: raiz do monorepo (não infra/docker/), porque o
# build depende do workspace inteiro — mesmo raciocínio do buildCommand real
# em railway.json:
#   docker build -f infra/docker/Dockerfile.api -t salas-senai-api .

# ─── Stage 1: builder ───────────────────────────────────────────────────
FROM node:22-alpine AS builder

# bcrypt (dependência real de apps/api, usada em auth) tem binding nativo —
# sem essas ferramentas, `pnpm install` falha tentando compilar o addon no
# Alpine (musl, sem toolchain de build por padrão na imagem node:22-alpine).
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copia o monorepo inteiro — pacotes workspace precisam estar presentes pra
# resolver em build-time (mesmo raciocínio do buildCommand real em railway.json).
COPY . .

# Versão de pnpm pinada em package.json ("packageManager": "pnpm@8.15.0") —
# corepack (já embutido no Node 22) garante a mesma versão do CI/Railway.
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @salas-senai/api exec prisma generate
RUN pnpm --filter @salas-senai/api build

# Compila prisma/seed.ts pra JS (seed sem depender de ts-node em produção —
# a imagem final não tem devDependencies). tsconfig.build.json EXCLUI
# "prisma" de propósito (não compila o seed junto do resto do build) e o
# tsconfig.json base tem rootDir="./src" (rejeitaria prisma/seed.ts por
# estar fora do rootDir se rodado via -p) — por isso é uma invocação
# isolada do tsc, fora de -p/tsconfig, só com os compiler options que
# afetam a SAÍDA (replicados de packages/tsconfig/base-node.json: target
# ES2022, module commonjs, esModuleInterop — flags que só afetam
# diagnóstico como --strict foram omitidas de propósito, o arquivo já
# passa no typecheck estrito normal do projeto via tsconfig.json, que
# inclui prisma/**/*.ts). --outDir prisma deixa o seed.js do lado do
# schema.prisma (rootDir inferido = pasta do único arquivo de entrada,
# então a saída não fica aninhada em mais um nível "prisma/prisma/").
RUN pnpm --filter @salas-senai/api exec tsc prisma/seed.ts \
    --outDir prisma \
    --target ES2022 \
    --module commonjs \
    --moduleResolution node \
    --esModuleInterop \
    --skipLibCheck

# ─── Stage 2: runner ─────────────────────────────────────────────────────
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

# node_modules em duas camadas (raiz = pnpm store real com os pacotes de
# node_modules/.pnpm; apps/api/node_modules = symlinks pro store) — as duas
# precisam vir juntas com a MESMA estrutura de diretório do builder (WORKDIR
# /app nos dois estágios), senão os symlinks relativos do pnpm quebram.
# TODO Missão 2 (ou otimização futura): avaliar `pnpm deploy`/`--prod` num
# ambiente com Docker real pra testar — copiar assim inclui devDependencies
# e fica maior que o necessário, mas é a opção que não depende de eu
# adivinhar um comando que não posso testar aqui.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json

# entrypoint.sh: prisma migrate deploy (idempotente, todo boot) + seed
# condicional (SEED_FORCE=true) + exec do servidor — ver o arquivo pros
# comentários de cada passo.
COPY infra/docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 3000

ENTRYPOINT ["sh", "/app/entrypoint.sh"]
