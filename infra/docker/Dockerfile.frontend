# infra/docker/Dockerfile.frontend
#
# Build do frontend React (@salas-senai/reservations) pro servidor local do
# SENAI. Substitui o deploy no GitHub Pages — o workflow cd.yml builda com
# `--base=/salas-senai-monorepo/` porque o GitHub Pages serve de um
# subpath; aqui o nginx serve a raiz do domínio (o IP do servidor), então
# o build roda SEM --base (confirmado lendo apps/reservations/package.json:
# "build": "tsc --noEmit && vite build" — sem --base embutido no script, e
# vite.config.ts não define um `base` fixo, então o default do Vite ("/")
# já é o que este setup precisa).
#
# Contexto de build esperado: raiz do monorepo (mesmo motivo do
# Dockerfile.api — o build depende do workspace pnpm inteiro):
#   docker build -f infra/docker/Dockerfile.frontend -t salas-senai-frontend .
# (VITE_API_URL já tem o default certo pra esta imagem: /api, ver abaixo.)

# ─── Stage 1: builder ───────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app
COPY . .

RUN corepack enable && corepack prepare pnpm@8.15.0 --activate
RUN pnpm install --frozen-lockfile

# VITE_API_URL é gravada DENTRO do bundle em build-time — Vite faz inline
# de toda var VITE_* (mesmo raciocínio já documentado no projeto: nada
# aqui protege segredo, só configura pra qual host o browser final vai
# mandar as requisições da API). ARG → ENV pra o `vite build` enxergar via
# import.meta.env.VITE_API_URL.
#
# Default /api (mesma origem): esta imagem traz o nginx-rotas.conf, que
# encaminha /api/ e /api/socket.io/ pra api (ADR-009, #21). Sem default, um
# build sem o arg gravaria '' no bundle e quebraria todas as chamadas. O
# docker-compose.yml também fixa /api; o build do GitHub Pages (cd.yml) não
# usa este Dockerfile e segue com a URL absoluta.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

RUN pnpm --filter @salas-senai/reservations build

# ─── Stage 2: runner ─────────────────────────────────────────────────────
FROM nginx:alpine AS runner

COPY --from=builder /app/apps/reservations/dist /usr/share/nginx/html
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf
# Fora de conf.d/: tudo que é *.conf ali entra no contexto http, e o snippet
# de rotas é do contexto server (incluído pelo nginx.conf).
COPY infra/docker/nginx-rotas.conf /etc/nginx/snippets/salas-senai-rotas.conf

EXPOSE 80
