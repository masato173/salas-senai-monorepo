# infra/docker/.env.local.example
#
# Template de variáveis de ambiente pro servidor local Docker (SENAI).
#
# 1. Copie este arquivo pra `.env.local` (mesma pasta, infra/docker/).
# 2. Preencha os valores reais abaixo — `.env.local` NUNCA é commitado
#    (entrada no .gitignore da raiz do repo).
# 3. Suba com: docker compose --env-file .env.local up -d --build
#
# Nomes de variável confirmados em apps/api/.env.example e
# apps/api/src/modules/config/env.schema.ts (validação Zod no boot —
# JWT_SECRET/JWT_REFRESH_SECRET são obrigatórias, o backend recusa subir
# sem elas ou com menos de 32 caracteres).

# ── Postgres ────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=salas_senai

# DATABASE_URL e DIRECT_URL apontam pro MESMO Postgres local — "postgres"
# é o nome do serviço no docker-compose.yml (resolvido pela rede interna
# do Docker), não é "localhost". Diferente do Supabase em nuvem (que tem
# pgbouncer gerenciado separando pool via porta 6543 de direct via 5432),
# aqui não existe esse pooler, então os dois valores são idênticos. Só
# troque se mudar usuário/senha/db acima.
DATABASE_URL=postgresql://postgres:troque-esta-senha@postgres:5432/salas_senai
DIRECT_URL=postgresql://postgres:troque-esta-senha@postgres:5432/salas_senai

# ── JWT ──────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres (validado no boot). Gere um valor aleatório com:
#   openssl rand -base64 32
# ou, sem openssl (PowerShell nativo do Windows):
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Use um valor DIFERENTE em cada uma das duas variáveis abaixo.
JWT_SECRET=gere-um-secret-de-no-minimo-32-caracteres-aqui
JWT_REFRESH_SECRET=gere-outro-secret-de-no-minimo-32-caracteres

# ── Rede ──────────────────────────────────────────────────────────────────
# O nginx (serviço frontend, porta 80) é a borda única (ADR-009, #21): o
# navegador carrega o frontend e chama a api na MESMA origem, em /api. Por
# isso estes valores de topologia ficam FIXOS no docker-compose.yml, não
# aqui — não adianta defini-los neste arquivo:
#   - VITE_API_URL=/api  (build arg do frontend; antes era a URL :3000)
#   - TRUST_PROXY='1'    (environment da api: um proxy à frente, o nginx)
# A api não publica mais a porta 3000.
#
# CORS_ORIGIN — OPCIONAL neste compose: com a api na mesma origem, o
# navegador não aplica CORS. Só preencha se outra origem precisar chamar a
# api (ex.: "http://192.168.1.50"; várias: separar por vírgula, sem espaço
# extra depois). Vazio = fallback de dev do backend (localhost:5173/4173),
# inofensivo aqui (ver apps/api/src/common/cors-origins.util.ts).
CORS_ORIGIN=

# ── Apps Script (SyncModule — POST /sync/schedules) ──────────────────────
# Opcional — deixe vazio se o sync de aulas com a planilha institucional
# não for usado neste ambiente. Sem valor, o endpoint de sync simplesmente
# não vai funcionar; o resto do sistema funciona normalmente.
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# ── Seed (usado pela Missão 2 — entrypoint com migrate+seed) ─────────────
# Deixe 'false'. Este deploy roda com NODE_ENV=production, e o entrypoint
# ABORTA o boot (exit 1) se SEED_FORCE=true em produção (issue 2) — o seed
# nunca roda em produção. Dados iniciais: dump/restore ou o procedimento
# manual do infra/docker/README.md (passo 4).
SEED_FORCE=false

# ── Node / segurança ──────────────────────────────────────────────────────
NODE_ENV=production
# 'true' desliga o rate limiting de login/refresh — só usado no CI de
# testes E2E. NUNCA deixe 'true' neste ambiente.
# O boot REJEITA THROTTLE_SKIP=true com NODE_ENV=production.
THROTTLE_SKIP=false

# ── Opcionais (têm valor default no backend — só documentando aqui) ──────
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
