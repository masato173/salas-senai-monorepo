{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@8.15.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@8.15.0 --filter @salas-senai/reservations build",
  "outputDirectory": "apps/reservations/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
