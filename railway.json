{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": ["apps/api/**", "package.json", "pnpm-lock.yaml", "railway.json"],
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @salas-senai/api exec prisma generate && pnpm --filter @salas-senai/api build"
  },
  "deploy": {
    "startCommand": "node apps/api/dist/main.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
